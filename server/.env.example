PORT=4000
# Origine du client React (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ── Projet Supabase de NEXIS Identity (authentification) ──
# Sert uniquement à vérifier le JWT de l'utilisateur.
IDENTITY_SUPABASE_URL=https://identity-xxxx.supabase.co
# Optionnel : seulement si ce projet signe encore ses jetons en HS256
# IDENTITY_JWT_SECRET=
# URL de NEXIS Identity (sans slash final) : fournit /api/me (permissions)
NEXIS_IDENTITY_URL=http://localhost:3000
# Clé de module pour les appels de serveur à serveur (SECRET). Même valeur que l'entrée « projets » de
# MODULE_API_KEYS chez NEXIS Identity. Permet d'envoyer les e-mails de rappel d'échéance (sans utilisateur)
# et les e-mails de notification même quand l'auteur de l'action n'a pas le droit users.read.
# IDENTITY_MODULE_KEY=

# Résumé quotidien par e-mail (nécessite IDENTITY_MODULE_KEY et Resend). Une seule instance du serveur le lance.
# Heure locale d'envoi (0-23, 8 par défaut) et fuseau IANA de cette heure (UTC par défaut) :
# DIGEST_HOUR=8
# DIGEST_TZ=Africa/Tunis
# « off » désactive le résumé :
# DAILY_DIGEST=off

# ── Projet Supabase PROPRE à ce module (données projets/tâches) ──
DATA_SUPABASE_URL=https://projets-xxxx.supabase.co
# SECRET : serveur uniquement
DATA_SUPABASE_SERVICE_ROLE_KEY=

# ── E-mails (Resend) ──
# Sans ces deux variables, les e-mails sont seulement écrits dans la console.
# Plan gratuit : 100 e-mails/jour, 3 000/mois, un seul domaine vérifié.
# RESEND_API_KEY=re_xxxxxxxx
# Expéditeur sur un domaine vérifié chez Resend (SPF/DKIM) :
# MAIL_FROM=NEXIS Projets <projets@votre-domaine.com>

# ── Notifications push (Firebase Cloud Messaging) ──
# Clé du compte de service : console Firebase > Paramètres du projet > Comptes de service > « Générer une nouvelle clé privée ».
# SECRET : serveur uniquement, jamais dans le dépôt. Soit le JSON sur une ligne, soit le chemin du fichier.
# Sans l'une des deux, le push est désactivé.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"nexis-projets",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

# URL publique de l'application (sans slash final) : lien « Ouvrir NEXIS Projets » des e-mails de notification
# ET lien d'invitation des invités externes (mode public). Obligatoire pour inviter.
# APP_URL=https://projets.votre-domaine.com

# Derrière un proxy (Render, Nginx, Cloudflare…) : nombre de proxys à croire (ex. 1). Sans cela, la limitation
# de débit du portail des invités voit l'IP du proxy pour tout le monde.
# TRUST_PROXY=1
