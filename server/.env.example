PORT=4000
# Origine du client React (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ── Projet Supabase de NEXIS Identity (authentification) ──
# Sert uniquement à vérifier le JWT de l'utilisateur.
IDENTITY_SUPABASE_URL=https://identity-xxxx.supabase.co
# Optionnel : seulement si ce projet signe encore ses jetons en HS256
# IDENTITY_JWT_SECRET=
# URL de NEXIS Identity (sans slash final) : fournit /api/me (permissions)
NEXIS_IDENTITY_URL=http://localhost:3000

# ── Projet Supabase PROPRE à ce module (données projets/tâches) ──
DATA_SUPABASE_URL=https://projets-xxxx.supabase.co
# SECRET : serveur uniquement
DATA_SUPABASE_SERVICE_ROLE_KEY=
