# URL de NEXIS Identity (le tableau de bord d'où l'on ouvre ce module), sans slash final
VITE_NEXIS_URL=http://localhost:3000
# Laisser vide en dev (proxy Vite vers :4000) ; URL de l'API en production
VITE_API_URL=

# Notifications push (Firebase) : valeurs de la config web (console Firebase > Paramètres du projet > Vos applications).
# Elles ne sont pas secrètes. Sans elles, l'option push n'apparaît pas dans la cloche.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=nexis-projets
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Console Firebase > Paramètres du projet > Cloud Messaging > Certificats Web Push > « Générer une paire de clés » (clé publique)
VITE_FIREBASE_VAPID_KEY=
